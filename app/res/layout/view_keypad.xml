<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:id="@+id/dialer_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/ios_card"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/banner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Diller as your default Phone app to get the liquid-glass call screen."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/banner_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/PillDark"
            android:text="Set as default Phone app" />
    </LinearLayout>

    <!-- number + "Add Number", like the reference -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/dial_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:textColor="@color/text_primary"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/btn_add_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Add Number"
            android:textColor="@color/ios_blue"
            android:textSize="17sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dial_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/ios_grey"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dial_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/chip_spam"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/keypad_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- bottom row: blank | green call | delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="78dp"
            android:layout_height="78dp" />

        <ImageView
            android:id="@+id/btn_call"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/call_btn_green"
            android:padding="22dp"
            android:src="@drawable/ic_call"
            android:contentDescription="@string/call" />

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/glass_circle"
            android:padding="20dp"
            android:src="@drawable/ic_backspace"
            android:visibility="invisible"
            android:contentDescription="@string/backspace" />
    </LinearLayout>
</LinearLayout>
