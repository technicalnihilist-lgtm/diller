<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:id="@+id/dialer_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/ios_card"
        android:padding="14dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/banner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Diller as your default Phone app to get the liquid-glass call screen on every call."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/banner_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/PillDark"
            android:text="Set as default Phone app" />
    </LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:minHeight="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/dial_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="start"
                android:textSize="38sp"
                android:textColor="@color/text_primary"
                android:text="" />

            <TextView
                android:id="@+id/dial_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dial_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/chip_spam"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_add_contact"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="start|center_vertical"
            android:padding="11dp"
            android:background="@drawable/row_circle"
            android:src="@drawable/ic_add_contact"
            android:contentDescription="@string/add_contact"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="end|center_vertical"
            android:padding="10dp"
            android:background="@drawable/row_circle"
            android:src="@drawable/ic_backspace"
            android:contentDescription="@string/backspace"
            android:visibility="invisible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/keypad_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.4" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="88dp">

        <ImageView
            android:id="@+id/btn_call"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="center"
            android:padding="21dp"
            android:background="@drawable/call_btn_green"
            android:src="@drawable/ic_call"
            android:contentDescription="@string/call" />
    </FrameLayout>
</LinearLayout>
