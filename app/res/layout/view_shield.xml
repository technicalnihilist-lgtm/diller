<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_shield"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shield_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_dark"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Shield OFF"
                android:textColor="@color/warn"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ios_card"
            android:padding="18dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Scam &amp; spam call screening" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Diller checks every incoming call on-device against known scam patterns and your blocklist, and warns you before you pick up."
                android:textColor="@color/ios_grey" android:textSize="13sp" />
            <TextView android:id="@+id/screen_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Status: not enabled" android:textColor="@color/warn" android:textSize="13sp" />
            <TextView android:id="@+id/btn_screen_role"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/PillDark"
                android:text="Turn on call screening" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ios_card"
            android:padding="18dp"
            android:layout_marginTop="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Liquid-glass call screen" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Make Diller your default Phone app and every call — incoming or outgoing — opens Diller's frosted-glass call screen."
                android:textColor="@color/ios_grey" android:textSize="13sp" />
            <TextView android:id="@+id/dialer_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Default phone app: not set" android:textColor="@color/warn" android:textSize="13sp" />
            <TextView android:id="@+id/btn_default_dialer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/PillDark"
                android:text="Set Diller as default Phone app" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ios_card"
            android:padding="18dp"
            android:layout_marginTop="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Blocked numbers" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/block_count"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 numbers blocked" android:textColor="@color/ios_grey" android:textSize="13sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
                <EditText android:id="@+id/block_input"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/search_bar" android:hint="Add number to block"
                    android:textColorHint="@color/ios_grey" android:textColor="@color/text_primary"
                    android:inputType="phone" android:singleLine="true" android:padding="12dp" />
                <TextView android:id="@+id/btn_block_add"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" style="@style/PillDark" android:text="Block" />
            </LinearLayout>

            <TextView android:id="@+id/btn_manage_block"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" style="@style/PillDark" android:text="View blocked numbers" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ios_card"
            android:padding="18dp"
            android:layout_marginTop="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Theft Guard" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Detects SIM-card swaps and repeated failed unlock attempts, sounds a loud alarm, and can lock or wipe the device if it is stolen."
                android:textColor="@color/ios_grey" android:textSize="13sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Monitor device" android:textColor="@color/text_primary" android:textSize="15sp" />
                <Switch android:id="@+id/guard_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView android:id="@+id/guard_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Device admin: not enabled" android:textColor="@color/ios_grey" android:textSize="13sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">
                <TextView android:id="@+id/btn_admin"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/PillDark" android:text="Enable device protection" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:id="@+id/btn_alarm"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/PillDark" android:text="Test alarm" />
                <TextView android:id="@+id/btn_lock"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    style="@style/PillDark" android:text="Lock device now" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ios_card"
            android:padding="18dp"
            android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Private by design" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No ads. No account. No sign-in. Everything runs on your phone — your calls, contacts and blocklist never leave the device."
                android:textColor="@color/ios_grey" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
