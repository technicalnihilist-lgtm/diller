<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:text="@string/tab_ai"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Daily summary -->
        <LinearLayout style="@style/GlassCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/ios_card" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Today's calls" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/ai_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Tap refresh"
                android:textColor="@color/ios_grey" android:textSize="14sp" />
            <TextView android:id="@+id/btn_summary_refresh"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" style="@style/PillDark" android:text="Summarise today" />
        </LinearLayout>

        <!-- Ask AI -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/ios_card"
            android:padding="18dp" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ask AI" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <EditText android:id="@+id/ai_input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/search_bar"
                android:hint="Ask anything…" android:textColorHint="@color/ios_grey"
                android:textColor="@color/text_primary" android:inputType="textMultiLine"
                android:padding="12dp" android:minLines="1" />
            <TextView android:id="@+id/btn_ask"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" style="@style/PillDark" android:text="Ask" />
            <TextView android:id="@+id/ai_reply"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/text_primary"
                android:textSize="14sp" android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Translate -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/ios_card"
            android:padding="18dp" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Translate" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <EditText android:id="@+id/tr_input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/search_bar"
                android:hint="Text to translate…" android:textColorHint="@color/ios_grey"
                android:textColor="@color/text_primary" android:inputType="textMultiLine"
                android:padding="12dp" android:minLines="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp">
                <TextView android:id="@+id/tr_lang"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/PillDark" android:text="Hindi" />
                <TextView android:id="@+id/btn_translate"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" style="@style/PillDark" android:text="Translate" />
            </LinearLayout>
            <TextView android:id="@+id/tr_out"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/text_primary"
                android:textSize="14sp" android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- AI call agent -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/ios_card"
            android:padding="18dp" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AI call agent" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Answers calls from unknown or suspected-spam numbers on your behalf and logs them here. Needs Diller set as your default Phone app."
                android:textColor="@color/ios_grey" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Answer calls with AI agent"
                    android:textColor="@color/text_primary" android:textSize="15sp" />
                <Switch android:id="@+id/agent_switch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/agent_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/ios_grey"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- History -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/ios_card"
            android:padding="18dp" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AI history" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/ai_history"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/ios_grey"
                android:textSize="13sp" android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <TextView android:id="@+id/btn_ai_settings"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="8dp"
            style="@style/PillDark" android:text="AI settings (API key)" />
    </LinearLayout>
</ScrollView>
