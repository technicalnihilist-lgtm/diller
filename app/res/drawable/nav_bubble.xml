<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient android:type="radial" android:gradientRadius="62dp"
                android:startColor="#553FC8FF" android:endColor="#003FC8FF" />
        </shape>
    </item>
    <item android:left="7dp" android:right="7dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="90"
                android:startColor="#7AFFFFFF"
                android:centerColor="#3DFFFFFF"
                android:endColor="#1FFFFFFF"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>
